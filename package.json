{
  "name": "golf-launch-monitor-sync",
  "private": true,
  "license": "MIT",
  "description": "Syncs launch monitor data from the player's own cloud account into apps of their choice, in an open format.",
  "repository": "github:golf-launch-monitor-sync/golf-launch-monitor-sync",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools --noEmit",
    "test": "vitest run",
    "vectors": "python3 spec/reference/generate.py",
    "vectors:check": "python3 spec/reference/generate.py --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
