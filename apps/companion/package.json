{
  "name": "@glmsync/companion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The companion app: the provider's sign-in on the phone, syncs when a target's plan says so.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/licenses.mjs",
    "bundle:check": "expo export --platform android --platform ios --output-dir dist",
    "postinstall": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@glmsync/core": "workspace:*",
    "@glmsync/provider-demo": "workspace:*",
    "@glmsync/provider-trackman": "workspace:*",
    "@glmsync/spec": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-background-task": "~58.0.13",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
